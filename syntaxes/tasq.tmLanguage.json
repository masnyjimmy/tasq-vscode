{
  "$schema": "https://json.schemastore.org/tmlanguage.json",
  "name": "My Task Language",
  "scopeName": "source.tasq",
  "patterns": [
    { "include": "#strings" },
    { "include": "#backtick-commands" },
    { "include": "#task-definition" },
    { "include": "#parameters" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tasq",
          "match": "\\b(set|task|group|if|else)\\b"
        },
        {
          "name": "keyword.operator.logical.tasq",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "task-definition": {
      "patterns": [
        {
          "match": "\\btask\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.tasq" }
          }
        }
      ]
    },
    "parameters": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*:\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "variable.parameter.tasq" },
            "2": { "name": "support.type.tasq" }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.tasq",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.tasq",
          "match": "\\bnull\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.tasq",
          "match": "\\b(string|flag|number)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.tasq",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.tasq",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.tasq",
          "match": "\\\\."
        }
      ]
    },
    "backtick-commands": {
      "name": "string.interpolated.tasq",
      "begin": "`",
      "end": "`",
      "patterns": [
        { "include": "#interpolation" }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.delimiter.tasq",
          "match": ","
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.tasq",
      "begin": "\\{\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.interpolation.begin.tasq" }
      },
      "end": "\\}\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.interpolation.end.tasq" }
      },
      "patterns": [
        {
          "name": "variable.other.readwrite.tasq",
          "match": "[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    }
  }
}